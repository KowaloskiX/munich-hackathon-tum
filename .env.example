# Copy to .env — .env is gitignored, .env.example is not. Never put a real key here.

# --- Mock loops (backend/app/main.py) ------------------------------------
# On by default so the dashboard is alive with no hardware. Flip to 0 as the
# real ESP nodes come online; MOCK=0 turns everything real at once.
# MOCK=1
# MOCK_HEARTBEAT=1
# MOCK_ANOMALY=1

# --- Agent (swap agent_stub.py for the real call at integration) ---------
# ANTHROPIC_API_KEY=
# DEVIN_API_KEY=

# --- Dashboard -----------------------------------------------------------
# Only needed if the backend is not on localhost:8000. Without it the live feed
# retries silently against the default and the page renders empty.
# VITE_WS_URL=ws://localhost:8000/live
