# Copy to .env and fill in. All optional — defaults keep the stub agent + no tracing.

# Which agent the system uses: "stub" (canned, offline) or "devin" (real API).
AGENT=stub

# Devin external API (v1). Service-user keys look like "cog_...".
DEVIN_API_KEY=
DEVIN_BASE_URL=https://api.devin.ai/v1
DEVIN_POLL_INTERVAL_S=5
DEVIN_TIMEOUT_S=900
# Cost / VM lifecycle
DEVIN_USD_PER_ACU=0            # >0 to also report USD in traces/CLI
DEVIN_MAX_ACU_LIMIT=10         # hard per-session ACU ceiling
DEVIN_RESUMABLE=false          # false = disposable VM, torn down on stop
DEVIN_TERMINATE_ON_DONE=true   # DELETE the session when finished (no idle VM)

# Durable autonomous-response analytics and memory.
ATTACK_RESPONSES_PATH=data/attack_responses.json

# Langfuse (local instance is fine). Leave blank to disable tracing (no-op).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
