# Copy to backend/.env. Never commit real credentials.

# Which agent the system uses: "stub" (canned, offline) or "devin" (real API).
AGENT=stub

# Devin external API v3. Service-user keys look like "cog_...".
DEVIN_API_KEY=
DEVIN_BASE_URL=https://api.devin.ai/v3
DEVIN_ORG_ID=
DEVIN_POLL_INTERVAL_S=10
DEVIN_TIMEOUT_S=900
# Cost / VM lifecycle
DEVIN_USD_PER_ACU=0            # >0 to also report USD in traces/CLI
DEVIN_MAX_ACU_LIMIT=10         # hard per-session ACU ceiling
DEVIN_RESUMABLE=false          # false = disposable VM, torn down on stop
DEVIN_TERMINATE_ON_DONE=true   # DELETE the session when finished (no idle VM)

# Gmail threat review stays disabled until every required value is present.
EMAIL_SECURITY_ENABLED=false
EMAIL_AGENT=stub
GOOGLE_CLOUD_PROJECT=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8000/v1/gmail/oauth/callback
GMAIL_PUBSUB_TOPIC=projects/PROJECT_ID/topics/sentinel-gmail-events
GMAIL_PUBSUB_SUBSCRIPTION=projects/PROJECT_ID/subscriptions/sentinel-gmail-local
GMAIL_ALLOWED_EMAIL=
EMAIL_TOKEN_ENCRYPTION_KEY=
APP_SESSION_SECRET=
EMAIL_DB_PATH=data/email-security.db
EMAIL_REPORT_RETENTION_DAYS=30
EMAIL_ANALYSIS_CONCURRENCY=1
EMAIL_MAX_BODY_CHARS=50000
EMAIL_MAX_ATTACHMENT_BYTES=10485760
EMAIL_MAX_TOTAL_ATTACHMENT_BYTES=20971520
DEVIN_EMAIL_MAX_ACU_LIMIT=1
DEVIN_EMAIL_MAX_TOTAL_ACU=2
DEVIN_EMAIL_TIMEOUT_S=600
DASHBOARD_URL=http://localhost:5173
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Durable autonomous-response analytics and memory (append-only JSONL).
ATTACK_RESPONSES_PATH=data/attack_responses.jsonl

# Langfuse (local instance is fine). Leave blank to disable tracing (no-op).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
